// kmer-GWAS pipeline — Nextflow configuration

manifest {
    name            = 'kmer-gwas-cpp'
    description     = 'k-mer GWAS matrix construction pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '4.1.0'
}

// Parameter validation against nextflow_schema.json (main.nf calls
// validateParameters). An unknown parameter, e.g. a typo, stops the run. The
// pipeline's own --help is used, so the plugin's help is off.
plugins {
    id 'nf-schema@2.7.3'
}
validation.logging.unrecognisedParams = 'error'
validation.help.enabled = false

params {
    help                   = false

    // Input
    accessions_file        = './accessions.txt'
    data_dir               = "${launchDir}/data"
    input_mode             = 'reads'   // 'reads': count k-mers from paired FASTQ/FASTA in data_dir.
                                       // 'kmc'  : convert pre-built KMC databases, one per accession,
                                       //          <kmc_dir>/<accession>.kmc_pre + .kmc_suf.
    kmc_dir                = null      // directory holding the KMC databases (kmc mode); null = data_dir
    kmc_detected_kmer_size = null      // DERIVED, do not set: the k read from the KMC databases (kmc mode),
                                       // filled in below and validated in main.nf.
    kmc_detected_format    = null      // DERIVED, do not set: the format version of that database
                                       // (0 = KMC1, 0x200 = KMC2).
    kmc_kmer_size_from_db  = false     // DERIVED, do not set: true when kmer_size was taken from the databases.
    kmc_detect_error       = null      // DERIVED, do not set: why the database could not be read, with its path.
    kmc_allow_mixed       = false     // kmc mode: report databases built with different -ci, -cx or
                                       // counter sizes as a warning instead of stopping the run.

    // Where the C++ sources are compiled from at job start: the checkout. All
    // profiles use this, including the container profiles: the image is only a
    // toolchain, its bundled source copy is not used (see conf/container.config).
    src_dir                = "${projectDir}/src"

    // Pipeline parameters
    kmer_size              = null      // k-mer length; must be ODD and 15..63. No default:
                                       // required in reads mode. In kmc mode it is read from
                                       // the databases (below); if given, it must match them.
                                       // k <= 32 uses a compact 10-byte record
                                       // instead of 18 (44% less Stage 1 output).
                                       // Compiled in as -DKMER_K, so no runtime cost.
    num_bins               = 1500      // A PARALLELISM / output-file-size knob. Stage 2's
                                       // k-way merge uses O(accessions) memory regardless of
                                       // bin count, so this does not need to track genome
                                       // size — it just sets how finely each stage is split.
    min_kmer_count         = null      // Drop k-mers seen fewer than this many times in an
                                       // accession. Low counts are overwhelmingly
                                       // sequencing errors; 2 drops singletons.
                                       // null = 2 in reads mode; in kmc mode, the databases
                                       // are kept as they are (their own -ci applies) and a
                                       // value above their -ci is enforced in addition.
    threshold              = 0
    keep_kmer_counts       = 'n'       // 'y'= keep raw kmer counts, 'n'=presence/absence
    skip_accession_check   = false     // Stage 2 stops if a pack records a different accession than its
                                       // file name; true allows packs renamed on purpose.
    count                  = null       // DEPRECATED alias for --keep_kmer_counts (renamed v3.7.5); mapped below.
    delimiter              = 'none'    // value separator for the text encoding: 'tab', 'space' or 'none'
                                       // default 'none' concatenates single chars (presence/absence)
    encoding               = 'text'    // 'text' (delimited) or 'bits' (1 bit/accession as hex, presence/absence only)
    write_core_kmers       = false     // write a per-bin <bin>_core.txt listing k-mers present in ALL
                                       // accessions. Independent of every other flag: it only adds this
                                       // file and never changes the matrix. false (default) = no core file.
    core                   = null      // DEPRECATED alias for --write_core_kmers (renamed v3.7.2); mapped below.
    kmer_count_cpus        = 32        // CPUs requested per KMER_COUNT job; kmer_count runs this many worker threads.
    matrix_merge_cpus      = 16        // CPUs requested per MATRIX_MERGE job, used BOTH by the merge and by the pigz
                                       // that compresses its output. The merge is parallel: it range-shards the
                                       // bin's key space into contiguous slices merged concurrently (output stays
                                       // byte-identical to a single-threaded run), scaling ~4.4x at 8 threads on the
                                       // measured data. Returns diminish past ~8-12 (pigz also saturates around 8), so
                                       // 16 is a sensible ceiling; raising it further mainly costs RAM (see
                                       // matrix_merge_memory) and, on a shared cluster, lets fewer bins run at once.
    kmer_count_memory      = 128.GB    // SLURM memory REQUEST per KMER_COUNT job (the --mem the scheduler
                                       // reserves, and the cgroup ceiling it enforces). The internal Stage 1
                                       // accumulation budget is auto-sized from that enforced limit, so this
                                       // is a scheduling knob, not the budget. For a whole node use
                                       // --clusterOptions='--mem=0'.
    kmer_count_budget_gb   = 0         // Stage 1 accumulation budget, GB.
                                       //   0 = AUTO (recommended): the budget is captured from the RAM
                                       //   actually enforced on the job — detected at run time from the
                                       //   cgroup limit, else SLURM env, else /proc/meminfo MemTotal — and
                                       //   set to 70% of it (the rest is headroom for read batches and the
                                       //   per-worker maps). This tracks the real node: a shared allocation,
                                       //   an --mem=0 exclusive node, or a bare workstation, with no guessing.
                                       //   A positive value forces that budget instead, still capped at the
                                       //   detected limit so it can never exceed what the cgroup will OOM-kill.
                                       //   See src/mem_limit.hpp.
    kmer_count_read_threads = 2        // Decompress the two mates concurrently (one thread per file). Inflate
                                       // is CPU-bound and the read-phase bottleneck on many-core nodes, so 2
                                       // roughly halves it on NVMe / parallel filesystems. Set 1 to serialise
                                       // on a single spinning disk, where concurrent reads seek-thrash.
    matrix_merge_memory    = 16.GB     // RAM requested per MATRIX_MERGE job. NOT a function of genome size: the merge
                                       // streams k-mers and never holds a bin's union. It is O(matrix_merge_cpus x
                                       // accessions), because each of the concurrent shard workers keeps one small
                                       // read buffer per accession (~36 KB each). At the default 16 CPUs and 10,000
                                       // accessions that is roughly 16 x 10,000 x 36 KB ~= 6 GB, so 16 GB holds it
                                       // with headroom for any genome; larger panels or a higher matrix_merge_cpus
                                       // scale this linearly. A job that runs short is retried with more memory
                                       // (see max_retries).
    kmer_count_time        = '5h'      // wallclock per KMER_COUNT job (override with --kmer_count_time '8h')
    matrix_merge_time      = '10h'     // wallclock per MATRIX_MERGE job (override with --matrix_merge_time '5h')
    // Robustness (SLURM profiles): a job killed by out-of-memory or timeout is retried with MORE memory and
    // wallclock each attempt (attempt x the base), so the occasional straggler in a large run self-heals
    // instead of failing the whole pipeline.
    max_retries            = 2         // extra attempts for an OOM/timeout-killed job (0 disables retry)
    // Ceilings that every request — including the escalated retries — is clamped to, so an escalated request can
    // never exceed what a node can actually provide (which would leave it unschedulable forever). Set these to
    // your largest node; the defaults suit a typical HPC node.
    max_memory             = 512.GB
    max_cpus               = 64
    max_time               = '24h'
    clusterOptions         = null      // extra SLURM options, e.g. '--account=myproject --partition=highmem'
    queue_size             = 200       // max jobs the SLURM executor keeps submitted (queued + running) at once
    cleanup                = false     // keep the work directory so -resume can skip finished work (with the default
                                       // kmer_count_publish_mode 'link' the packs left in work are hard links, so this costs no
                                       // extra data storage). Set --cleanup true to delete work on success instead;
                                       // that also disables -resume. Either way you can delete the work dir yourself
                                       // when the run is complete.
    publish_mode           = null      // DEPRECATED alias for --kmer_count_publish_mode (renamed v3.7.4); mapped below.
    kmer_count_publish_mode = 'link'   // how each KMER_COUNT (Stage 1) pack reaches output_dir:
                                       //   'link' (default): a hard link — no second copy of the data (one inode),
                                       //     and -resume can skip finished accessions because the pack stays in the
                                       //     work dir too. REQUIRES output_dir and the work dir on the SAME
                                       //     filesystem (checked at launch); true when you launch from scratch and
                                       //     leave output_dir at its default.
                                       //   'copy': a full second copy in output_dir. -resume works on any layout,
                                       //     but keeps ~2x storage (a second pack per accession) until cleanup.
                                       //   'move': no second copy, but -resume CANNOT skip finished accessions
                                       //     (the pack is moved out of the work dir). Lowest footprint, no resume.
    matrix_publish_mode    = 'link'    // same choices as kmer_count_publish_mode, but for the Stage 2 matrix (the final
                                       //   deliverable). Defaults to 'link': the matrices are already gzipped and
                                       //   never re-compressed after publish, so unlike the packs there is no
                                       //   compression step to break the hard link, and linking avoids a second copy
                                       //   of what is one of the largest outputs of a large run. A hard link survives
                                       //   --cleanup (the inode persists via the output_dir name). Same 'link' requires
                                       //   same-filesystem rule as kmer_count_publish_mode. Set 'copy' for a fully independent
                                       //   archival copy of the result.
    compress_kbin_packs    = false     // after BOTH stages finish successfully, gzip the published .kbin packs
                                       // (one job per accession, gated on all of Stage 2 so a pack is never
                                       // compressed while it might still be read). The gain is modest (~1.5-2x:
                                       // the 2-bit keys barely compress; it varies with k and coverage). Re-running
                                       // Stage 2 then needs the packs decompressed first. NOTE: with the default
                                       // kmer_count_publish_mode 'link' + cleanup false the uncompressed pack survives as a
                                       // hard link in the work dir, so nothing is reclaimed until work is removed;
                                       // launch warns about this. Use with --cleanup true (or --kmer_count_publish_mode move).
    singularity_cache_dir  = "${launchDir}/.singularity"  // Singularity/Apptainer image cache; override per HPC: --singularity_cache_dir /path/to/cache
    container_mount_dirs   = null      // DERIVED, do not set: host directories mounted in the container (conf/container.config).
    local_limit_cpus       = null      // DERIVED, do not set: CPUs the local executor can use (conf/local.config).
    local_limit_memory     = null      // DERIVED, do not set: memory the local executor can use (conf/local.config).

    // Output
    output_dir             = "${launchDir}/results"
}

// Deprecated-flag shim: --core was renamed to --write_core_kmers in v3.7.2. If the
// old flag was passed, map its y/n (or true/false) onto the new boolean so existing
// commands keep working; main.nf emits the deprecation warning. Remove in a later release.
params.write_core_kmers = params.core != null ? (params.core.toString().toLowerCase() in ['y', 'true']) : params.write_core_kmers

// Deprecated-flag shim: --publish_mode was renamed to --kmer_count_publish_mode in
// v3.7.4 (once a second, matrix, publish mode existed the bare name was ambiguous).
// If the old flag was passed, carry it onto the new one; main.nf warns. Remove later.
params.kmer_count_publish_mode = params.publish_mode != null ? params.publish_mode : params.kmer_count_publish_mode

// Deprecated-flag shim: --count was renamed to --keep_kmer_counts in v3.7.5 (the
// bare name was easily confused with --min_kmer_count). If the old flag was passed,
// carry its y/n onto the new one; main.nf warns. Remove in a later release.
params.keep_kmer_counts = params.count != null ? params.count : params.keep_kmer_counts

// kmc mode: the k-mer size is fixed by the databases, so read it from the first
// accession's <kmc_dir>/<accession>.kmc_pre. The file starts and ends with "KMCP";
// the 4 bytes before the trailing marker are the header size and the 4 bytes before
// those are the format version (uint32, little-endian). k is read only from the
// KMC2 format (0x200), which KMC 2 and 3 write by default: its header starts at
// filesize - 8 - header_size and its first uint32 is kmer_length. Other formats
// leave k unset, so main.nf asks for --kmer_size. The value goes to kmc_detected_kmer_size (main.nf checks
// an explicit --kmer_size against it) and becomes kmer_size when none was given.
// This must happen here: only a config-level assignment reaches the modules'
// ${params.kmer_size}. Any failure leaves both unset, records the reason (with the
// full path tried) in kmc_detect_error, and main.nf reports it, so reads mode and
// `nextflow config` are never affected.
params.kmc_detect_error = params.input_mode != 'kmc' ? null : { ->
    def why = null
    try {
        def kdir = (params.kmc_dir ?: params.data_dir).toString()
        def af   = new File(params.accessions_file.toString()).absoluteFile
        def acc  = af.isFile() ? af.readLines()*.trim().find { line -> line } : null
        def pre  = acc ? new File(kdir, "${acc}.kmc_pre").absoluteFile : null
        // A ".." after a symlink is resolved from the symlink target, not by
        // removing the previous path element; report both when they differ.
        def dots = ''
        if (kdir.split('/').contains('..')) {
            def real = new File(kdir).canonicalPath
            def text = new File(kdir).absoluteFile.toPath().normalize().toFile()
            if (real != text.canonicalPath)
                dots = "; note: ${kdir} resolves to ${real}, not ${text.path} (a '..' after a symlink goes to the parent of the symlink target)"
        }
        def where = pre ? "${pre.path} (first accession in ${af.path})${dots}" : ''
        if (!af.isFile())          why = "accessions file not found: ${af.path}"
        else if (!acc)             why = "accessions file has no accession: ${af.path}"
        else if (!pre.exists())    why = "KMC database not found: ${where}"
        else if (!pre.canRead())   why = "KMC database not readable: ${where}"
        else if (pre.length() < 12) why = "not a KMC database (file too short): ${where}"
        else {
            new java.io.RandomAccessFile(pre, 'r').withCloseable { raf ->
                // One 4-byte value at pos: the raw int (markers) or a little-endian uint32.
                def raw  = { long pos -> raf.seek(pos); raf.readInt() }
                def le32 = { long pos -> Integer.toUnsignedLong(Integer.reverseBytes(raw.call(pos))) }
                def KMCP = 0x4B4D4350   // "KMCP" read as a big-endian int
                def len    = raf.length()
                def hsize  = le32.call(len - 8)
                def format = le32.call(len - 12)
                if (raw.call(0) != KMCP || raw.call(len - 4) != KMCP)
                    why = "not a KMC database (no KMCP markers; incomplete or another file type): ${where}"
                else {
                    params.kmc_detected_format = format
                    if (format == 0x200 && hsize > 0 && len - 8 - hsize >= 4) {
                        params.kmc_detected_kmer_size = le32.call(len - 8 - hsize) as int
                        if (params.kmer_size == null) {
                            params.kmer_size = params.kmc_detected_kmer_size
                            params.kmc_kmer_size_from_db = true
                        }
                    }
                }
            }
        }
    } catch (Exception e) { why = "could not read the KMC database header: ${e.message}" }
    return why
}()

// Execution reports
timeline {
    enabled = true
    file    = "${params.output_dir}/reports/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.output_dir}/reports/report.html"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.output_dir}/reports/dag.svg"
    overwrite = true
}

cleanup = params.cleanup

includeConfig 'conf/base.config'

// Profiles have two parts; select one of each with a comma, e.g.
// -profile slurm,singularity or -profile local,docker.
//   executor: local, slurm
//   software: singularity, apptainer, docker, podman (none = host compiler)
// main.nf stops if two executors or two container engines are selected.
profiles {
    local {
        includeConfig 'conf/local.config'
    }
    // Nextflow selects 'standard' when no -profile is given.
    standard {
        includeConfig 'conf/local.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }

    singularity {
        includeConfig 'conf/container.config'
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = params.singularity_cache_dir
            runOptions = '--bind ' + params.container_mount_dirs.join(',')
        }
    }
    apptainer {
        includeConfig 'conf/container.config'
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = params.singularity_cache_dir
            runOptions = '--bind ' + params.container_mount_dirs.join(',')
        }
    }
    docker {
        includeConfig 'conf/container.config'
        docker {
            enabled    = true
            // Run as the calling user, so the output files are not owned by root.
            runOptions = '-u $(id -u):$(id -g) ' + params.container_mount_dirs.collect { d -> "-v ${d}:${d}" }.join(' ')
        }
    }
    podman {
        includeConfig 'conf/container.config'
        podman {
            enabled    = true
            runOptions = params.container_mount_dirs.collect { d -> "-v ${d}:${d}" }.join(' ')
        }
    }
}
