// kmer-GWAS pipeline — Nextflow configuration

manifest {
    name            = 'kmer-gwas-cpp'
    description     = 'k-mer GWAS matrix construction pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.0.0'
    version         = '3.7.1'
}

params {
    help                   = false

    // Input
    accessions_file        = './accessions.txt'
    data_dir               = "${launchDir}/data"

    // Where the C++ sources are compiled from at job start: the checkout. All
    // profiles use this, including slurm_container — the image is only a
    // toolchain, its bundled source copy is not used (see the profile note).
    src_dir                = "${projectDir}/src"

    // Pipeline parameters
    kmer_size              = 51        // k-mer length; must be ODD and 15..63.
                                       // k <= 32 uses a compact 10-byte record
                                       // instead of 18 (44% less Stage 1 output).
                                       // Compiled in as -DKMER_K, so no runtime cost.
    num_bins               = 1500      // Now a PARALLELISM / output-file-size knob only.
                                       // Stage 2 memory used to scale with the union of
                                       // k-mers per bin, forcing bin count up on large
                                       // genomes; the k-way merge made it O(accessions),
                                       // so this no longer has to track genome size.
    min_kmer_count         = 2         // Drop k-mers seen fewer than this many times in an
                                       // accession. Low counts are overwhelmingly
                                       // sequencing errors; 2 reproduces the old behaviour.
    threshold              = 0
    count                  = 'n'       // 'y'=counts, 'n'=presence/absence
    delimiter              = 'none'    // value separator for the text encoding: 'tab', 'space' or 'none'
                                       // default 'none' concatenates single chars (presence/absence)
    encoding               = 'text'    // 'text' (delimited) or 'bits' (1 bit/accession as hex, presence/absence only)
    core                   = 'n'       // 'y'=write core k-mers file, 'n'=skip
    matrix_merge_cpus      = 16        // CPUs requested per MATRIX_MERGE job, used BOTH by the merge and by the pigz
                                       // that compresses its output. The merge is now parallel: it range-shards the
                                       // bin's key space into contiguous slices merged concurrently (output stays
                                       // byte-identical to a single-threaded run), scaling ~4.4x at 8 threads on the
                                       // measured data. Returns diminish past ~8-12 (pigz also saturates around 8), so
                                       // 16 is a sensible ceiling; raising it further mainly costs RAM (see
                                       // matrix_merge_memory) and, on a shared cluster, lets fewer bins run at once.
    kmer_count_memory      = 128.GB    // SLURM memory REQUEST per KMER_COUNT job (the --mem the scheduler
                                       // reserves, and the cgroup ceiling it enforces). The internal Stage 1
                                       // accumulation budget is auto-sized from that enforced limit, so this
                                       // is a scheduling knob, not the budget. For a whole node use
                                       // --clusterOptions='--mem=0'.
    kmer_count_budget_gb   = 0         // Stage 1 accumulation budget, GB.
                                       //   0 = AUTO (recommended): the budget is captured from the RAM
                                       //   actually enforced on the job — detected at run time from the
                                       //   cgroup limit, else SLURM env, else /proc/meminfo MemTotal — and
                                       //   set to 70% of it (the rest is headroom for read batches and the
                                       //   per-worker maps). This tracks the real node: a shared allocation,
                                       //   an --mem=0 exclusive node, or a bare workstation, with no guessing.
                                       //   A positive value forces that budget instead, still capped at the
                                       //   detected limit so it can never exceed what the cgroup will OOM-kill.
                                       //   See src/mem_limit.hpp.
    kmer_count_read_threads = 2        // Decompress the two mates concurrently (one thread per file). Inflate
                                       // is CPU-bound and the read-phase bottleneck on many-core nodes, so 2
                                       // roughly halves it on NVMe / parallel filesystems. Set 1 to serialise
                                       // on a single spinning disk, where concurrent reads seek-thrash.
    matrix_merge_memory    = 16.GB     // RAM requested per MATRIX_MERGE job. Still NOT genome size: the merge streams
                                       // k-mers and never holds a bin's union. It is now O(matrix_merge_cpus x
                                       // accessions), because each of the concurrent shard workers keeps one small
                                       // read buffer per accession (~36 KB each). At the default 16 CPUs that is
                                       // roughly 16 x 12,600 x 36 KB ~= 7 GB for a 12,600-accession panel, so 16 GB
                                       // holds it with headroom for any genome (wheat included); larger panels or a
                                       // higher matrix_merge_cpus scale this linearly. A job that runs short is
                                       // retried with more memory (see max_retries).
    kmer_count_time        = '5h'      // wallclock per KMER_COUNT job (override with --kmer_count_time '8h')
    matrix_merge_time      = '10h'     // wallclock per MATRIX_MERGE job (override with --matrix_merge_time '5h')
    // Robustness (SLURM profiles): a job killed by out-of-memory or timeout is retried with MORE memory and
    // wallclock each attempt (attempt x the base), so the occasional straggler in a large run self-heals
    // instead of failing the whole pipeline.
    max_retries            = 2         // extra attempts for an OOM/timeout-killed job (0 disables retry)
    // Ceilings that every request — including the escalated retries — is clamped to, so an escalated request can
    // never exceed what a node can actually provide (which would leave it unschedulable forever). Set these to
    // your largest node; the defaults suit a typical HPC node.
    max_memory             = 512.GB
    max_cpus               = 64
    max_time               = '24h'
    clusterOptions         = null      // extra SLURM options, e.g. '--account=myproject --partition=highmem'
    queue_size             = 200       // max jobs the SLURM executor keeps submitted (queued + running) at once
    cleanup                = false     // keep the work directory so -resume can skip finished work (with the default
                                       // publish_mode 'link' the packs left in work are hard links, so this costs no
                                       // extra data storage). Set --cleanup true to delete work on success instead;
                                       // that also disables -resume. Either way you can delete the work dir yourself
                                       // when the run is complete.
    publish_mode           = 'link'    // how each KMER_COUNT pack reaches output_dir:
                                       //   'link' (default): a hard link — no second copy of the data (one inode),
                                       //     and -resume can skip finished accessions because the pack stays in the
                                       //     work dir too. REQUIRES output_dir and the work dir on the SAME
                                       //     filesystem (checked at launch); true when you launch from scratch and
                                       //     leave output_dir at its default.
                                       //   'copy': a full second copy in output_dir. -resume works on any layout,
                                       //     but keeps ~2x storage (a second pack per accession) until cleanup.
                                       //   'move': no second copy, but -resume CANNOT skip finished accessions
                                       //     (the pack is moved out of the work dir). Lowest footprint, no resume.
    singularity_cache_dir  = "${launchDir}/.singularity"  // override per HPC: --singularity_cache_dir /path/to/cache

    // Output
    output_dir             = "${launchDir}/results"
}

// Execution reports
timeline {
    enabled = true
    file    = "${params.output_dir}/reports/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.output_dir}/reports/report.html"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.output_dir}/reports/dag.svg"
    overwrite = true
}

cleanup = params.cleanup

profiles {
    standard {
        process {
            executor = 'local'
            // Declare per-process memory locally too, so the local executor gates
            // concurrency on RAM (not just CPUs) against the executor.memory pool
            // below — otherwise several KMER_COUNT tasks can run at once and each
            // auto-sizes its budget to the whole machine, over-committing it. It
            // also gives the budget a scheduler request to detect on a workstation.
            withName: 'KMER_COUNT'   { memory = params.kmer_count_memory }
            withName: 'MATRIX_MERGE' { memory = params.matrix_merge_memory }
        }
        executor {
            name   = 'local'
            cpus   = 32
            memory = '128.GB'
        }
    }

    slurm_container {
        process {
            executor       = 'slurm'
            clusterOptions = (params.clusterOptions instanceof String) ? params.clusterOptions : null
            // Clamp every request (including the escalated retries below) to what a node can provide, so an
            // over-large request can never become permanently unschedulable.
            resourceLimits = [ memory: params.max_memory, cpus: params.max_cpus, time: params.max_time ]
            // Retry only on out-of-memory / timeout exit codes, with more memory and wallclock each attempt.
            errorStrategy  = { task.exitStatus in [104,125,134,137,139,140,143,247] ? 'retry' : 'finish' }
            maxRetries     = params.max_retries
            withName: 'KMER_COUNT' {
                cpus   = 32
                memory = { params.kmer_count_memory * task.attempt }
                time   = { (params.kmer_count_time as nextflow.util.Duration) * task.attempt }
            }
            withName: 'MATRIX_MERGE' {
                cpus   = params.matrix_merge_cpus
                memory = { params.matrix_merge_memory * task.attempt }
                time   = { (params.matrix_merge_time as nextflow.util.Duration) * task.attempt }
            }
        }
        executor {
            queueSize       = params.queue_size
            submitRateLimit = '10 sec'
        }
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = params.singularity_cache_dir
            // projectDir must be bound: the jobs compile from the checkout's
            // src/ (see the note below), not from the copy inside the image.
            // output_dir must be bound too: Stage 2 reads the published pack
            // directory, so an --output_dir outside launchDir would otherwise be
            // invisible inside the container.
            // Both the absolute and the canonical form of each path are bound:
            // on HPC filesystems these differ when symlinks are involved, and
            // the container needs whichever one the job actually resolves.
            // Normalised and de-duplicated so the list stays readable and free
            // of artefacts like a trailing "/." from a relative --accessions_file.
            // The FASTQ in data_dir are commonly symlinks to another location (to
            // avoid copying large files). The symlink names live under data_dir,
            // which is bound, but their TARGETS do not, so they dangle inside the
            // container and the job fails to find the reads. Bind the target
            // directory of every data_dir entry as well, in BOTH forms:
            //   - canonicalPath: the fully-resolved real directory.
            //   - the literal target as the symlink STORES it: on HPC a bound
            //     prefix can itself be a symlink (e.g. /project -> /lustre2/project),
            //     so canonicalPath binds /lustre2/project/... but inside the
            //     container the symlink is followed via the path it stores
            //     (/project/...), whose prefix is absent there and so dangles.
            //     Binding the literal-target parent too makes the symlink resolve
            //     whichever prefix it references.
            // For a real (non-symlink) file both reduce to data_dir, which unique()
            // collapses.
            runOptions = "--bind " + (
                ([
                    projectDir.toString(),
                    launchDir.toString(),
                    new File(params.output_dir.toString()).absoluteFile.toPath().normalize().toString(),
                    new File(params.data_dir.toString()).absoluteFile.toPath().normalize().toString(),
                    new File(params.data_dir.toString()).canonicalPath,
                    new File(params.accessions_file.toString()).absoluteFile.parentFile.toPath().normalize().toString(),
                    new File(params.accessions_file.toString()).canonicalFile.parentFile.canonicalPath
                ] + (new File(params.data_dir.toString()).listFiles() ?: []).collectMany { f ->
                    def dirs = [ f.canonicalFile.parentFile.canonicalPath ]
                    try {
                        def p = f.toPath()
                        if (java.nio.file.Files.isSymbolicLink(p)) {
                            def tgt = p.toAbsolutePath().getParent()
                                        .resolve(java.nio.file.Files.readSymbolicLink(p)).normalize()
                            dirs << tgt.getParent().toString()
                        }
                    } catch (Exception e) { }
                    dirs
                }).unique().join(',')
            )
        }
        // NOTE: src_dir is deliberately NOT overridden to the image's
        // /opt/kmer-gwas/src. The image is used purely as a toolchain (GCC 12,
        // zlib, pigz); the source compiled is the checkout you are running.
        //
        // Pointing at the image's copy meant the code that ran was whatever had
        // been baked into the pinned tag, so any source change required a new
        // tag, a CI build and a pin bump before it took effect — and if those
        // drifted, the container silently ran different code from the other
        // profiles. That is what happened after the counting/merging rewrite:
        // the pinned v2.5.0 image still held the pre-rewrite sources.
        //
        // Compiling from the checkout removes that class of skew entirely. The
        // image only needs rebuilding when the *toolchain* changes.
        process.container = 'ghcr.io/mjfi2sb3/kmer-gwas-cpp:v3.7.1'
    }

    slurm {
        process {
            executor       = 'slurm'
            clusterOptions = (params.clusterOptions instanceof String) ? params.clusterOptions : null
            // Clamp every request (including the escalated retries below) to what a node can provide, so an
            // over-large request can never become permanently unschedulable.
            resourceLimits = [ memory: params.max_memory, cpus: params.max_cpus, time: params.max_time ]
            // Retry only on out-of-memory / timeout exit codes, with more memory and wallclock each attempt.
            errorStrategy  = { task.exitStatus in [104,125,134,137,139,140,143,247] ? 'retry' : 'finish' }
            maxRetries     = params.max_retries
            withName: 'KMER_COUNT' {
                cpus   = 32
                memory = { params.kmer_count_memory * task.attempt }
                time   = { (params.kmer_count_time as nextflow.util.Duration) * task.attempt }
            }
            withName: 'MATRIX_MERGE' {
                cpus   = params.matrix_merge_cpus
                memory = { params.matrix_merge_memory * task.attempt }
                time   = { (params.matrix_merge_time as nextflow.util.Duration) * task.attempt }
            }
        }
        executor {
            queueSize       = params.queue_size
            submitRateLimit = '10 sec'
        }
    }
}
