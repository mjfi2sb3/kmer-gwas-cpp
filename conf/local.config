// Executor profile 'local': run every task on this machine.
//
// The task pool is the CPUs and memory available to this run, capped at
// --max_cpus and --max_memory. CPUs: the JVM counts only the CPUs this process
// may use (e.g. a SLURM allocation). Memory: the smallest of the machine total,
// the cgroup limits (v2: memory.max from this process's cgroup up to the root;
// v1: memory.limit_in_bytes) and SLURM_MEM_PER_NODE, as in src/mem_limit.hpp.
// resourceLimits clamps each request to the same values, so a process that asks
// for more than the machine has runs with what there is.
// No time limit and no retries.
def local_cpus = Math.min(Runtime.runtime.availableProcessors(), params.max_cpus as int)
def local_memory = { ->
    def limits = [ java.lang.management.ManagementFactory.operatingSystemMXBean.totalMemorySize as long,
                   new nextflow.util.MemoryUnit(params.max_memory.toString()).toBytes() ]
    def num = { String t -> (t ==~ /\d+/) ? (t as BigInteger) : null }
    try {
        def rel = new File('/proc/self/cgroup').readLines().find { it.startsWith('0::') }?.substring(3)
        for (def d = rel != null ? new File('/sys/fs/cgroup' + rel) : null;
             d != null && d.path.startsWith('/sys/fs/cgroup'); d = d.parentFile) {
            def f = new File(d, 'memory.max')
            def v = f.canRead() ? num(f.text.trim()) : null
            if (v != null && v > 0) limits << (v as long)
        }
    } catch (Exception e) { }
    try {
        def v = num(new File('/sys/fs/cgroup/memory/memory.limit_in_bytes').text.trim())
        if (v != null && v > 0 && v < (1L << 60)) limits << (v as long)
    } catch (Exception e) { }
    def slurm = System.getenv('SLURM_MEM_PER_NODE')
    if (slurm ==~ /\d+/ && (slurm as long) > 0) limits << (slurm as long) * 1024L * 1024L
    new nextflow.util.MemoryUnit(limits.min())
}()

// Recorded for the banner and run_manifest.txt.
params.local_limit_cpus   = local_cpus
params.local_limit_memory = local_memory

process {
    executor       = 'local'
    resourceLimits = [ cpus: local_cpus, memory: local_memory ]
}
executor {
    name   = 'local'
    cpus   = local_cpus
    memory = local_memory
}
