// Executor profile 'slurm': submit every task as a SLURM job.
process {
    executor       = 'slurm'
    clusterOptions = (params.clusterOptions instanceof String) ? params.clusterOptions : null
    // Clamp every request (including the escalated retries below) to what a node can provide, so an
    // over-large request can never become permanently unschedulable.
    resourceLimits = [ memory: params.max_memory, cpus: params.max_cpus, time: params.max_time ]
    // Retry only on out-of-memory / timeout exit codes, with more memory and wallclock each attempt.
    errorStrategy  = { task.exitStatus in [104,125,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries     = params.max_retries
    // Some schedulers reject a job with no time limit, so every job needs one.
    time           = { 1.h * task.attempt }
    withName: 'KMER_COUNT|KMC_TO_PACK' {
        time = { (params.kmer_count_time as nextflow.util.Duration) * task.attempt }
    }
    withName: 'MATRIX_MERGE|COMPRESS_PACKS' {
        time = { (params.matrix_merge_time as nextflow.util.Duration) * task.attempt }
    }
}
executor {
    queueSize       = params.queue_size
    submitRateLimit = '10 sec'
}
