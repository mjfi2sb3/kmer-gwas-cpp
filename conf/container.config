// Shared by the container profiles (singularity, apptainer, docker, podman):
// the image, and the host directories the container must see.
//
// The image is used only as a toolchain (GCC 12, zlib-ng, pigz). The jobs
// compile the source in this checkout (params.src_dir), not the copy inside the
// image, so the code that runs is the same in every profile and a source change
// does not need a new image.
process.container = 'ghcr.io/mjfi2sb3/kmer-gwas-cpp:v4.0.0'

// Directories to mount, each at the same path inside the container:
//   - projectDir: the jobs compile from the checkout's src/.
//   - launchDir, output_dir: Stage 2 reads the published pack directory, so an
//     --output_dir outside launchDir must be mounted too.
//   - the accessions file's directory.
//   - the Stage 1 input directory of the selected mode: data_dir in reads mode,
//     kmc_dir (default data_dir) in kmc mode. Only that one: a mount path that
//     does not exist stops the container, and in kmc mode data_dir usually does
//     not exist.
// Each path is mounted in its absolute and its canonical form, because on HPC
// filesystems these differ when symlinks are involved, and the job may resolve
// either one.
// The input files are often symlinks to another location. The symlink names are
// under the input directory, but their targets are not, so the target directory
// of every input entry is mounted too, in two forms:
//   - canonicalPath: the fully resolved real directory.
//   - the target as the symlink stores it: a mounted prefix can itself be a
//     symlink (e.g. /project -> /lustre2/project). canonicalPath then mounts
//     /lustre2/project/..., but inside the container the symlink is followed
//     through the path it stores (/project/...), which would not exist there.
// For a file that is not a symlink, both reduce to the input directory.
params.container_mount_dirs = (params.input_mode == 'kmc' ? (params.kmc_dir ?: params.data_dir) : params.data_dir).toString().with { input_dir ->
    ([
        projectDir.toString(),
        launchDir.toString(),
        new File(params.output_dir.toString()).absoluteFile.toPath().normalize().toString(),
        new File(input_dir).absoluteFile.toPath().normalize().toString(),
        new File(input_dir).canonicalPath,
        new File(params.accessions_file.toString()).absoluteFile.parentFile.toPath().normalize().toString(),
        new File(params.accessions_file.toString()).canonicalFile.parentFile.canonicalPath
    ] + ((new File(input_dir).listFiles() ?: []) as List).collectMany { f ->
        def dirs = [ f.canonicalFile.parentFile.canonicalPath ]
        try {
            def p = f.toPath()
            if (java.nio.file.Files.isSymbolicLink(p)) {
                def tgt = p.toAbsolutePath().getParent()
                            .resolve(java.nio.file.Files.readSymbolicLink(p)).normalize()
                dirs << tgt.getParent().toString()
            }
        } catch (Exception e) { }
        dirs
    }).unique()
}
