// CPUs and memory of each process. They apply with every executor profile: the
// local executor uses them to decide how many tasks run at once, and SLURM uses
// them as the job request. The executor profiles (conf/local.config,
// conf/slurm.config) clamp them to what a machine or node can give.
//
// The values are closures, so they read params when a task starts. A param set
// in a -c config file is applied after this file, so a plain value would
// keep the default.
//
// Memory is multiplied by task.attempt so that a retried job gets more. Only
// the slurm profile retries; with no retry, task.attempt is always 1.
process {
    // Defaults for every process without its own settings (e.g. BUILD_TOOLS).
    cpus   = 1
    memory = { 2.GB * task.attempt }

    withName: 'KMER_COUNT' {
        cpus   = { params.kmer_count_cpus }
        memory = { params.kmer_count_memory * task.attempt }
    }
    // kmc input mode: the conversion is single-threaded, so few CPUs; it
    // reuses the Stage 1 memory setting.
    withName: 'KMC_TO_PACK' {
        cpus   = 2
        memory = { params.kmer_count_memory * task.attempt }
    }
    withName: 'MATRIX_MERGE' {
        cpus   = { params.matrix_merge_cpus }
        memory = { params.matrix_merge_memory * task.attempt }
    }
    // pigz the packs; streaming, so little memory. Reuses matrix_merge_cpus.
    withName: 'COMPRESS_PACKS' {
        cpus   = { params.matrix_merge_cpus }
        memory = { 4.GB * task.attempt }
    }
}
